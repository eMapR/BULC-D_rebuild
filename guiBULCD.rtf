    // --------------------------------------------------------------------------------\
    // 4C. afn_runBULCD_Code() \
    // --------------------------------------------------------------------------------\
    function afn_runBULCD_Code() \{\
              // Update the main parameter dictionary (D) with the expectation and target collection parameters.\
\
        D = helperFunctionsBULCD.updateParams(D, "expectationCollectionParameters", expectationCollectionParameters);\
        D = helperFunctionsBULCD.updateParams(D, "targetCollectionParameters", targetCollectionParameters);\
        if (verbose) \{\
            print('Verbose output: Whole dictionary', D)\
        \}\
        // ----------------------------------------------------------------------------\
        // ORGANIZE INPUTS & RUN BULC-D ALGORITHM\
        // ----------------------------------------------------------------------------\
\
        // Prepare the input data for the BULC-D algorithm. \
        bulcD_input = afn_organizeBULCD_Inputs(D);\
        print("Organized values for BULC-D", bulcD_input)\
\
        // ----------------------------------------------------------------------------\
        // PREPARE ARGUMENTS FOR BULC-D\
        // ----------------------------------------------------------------------------\
\
        // Set up the argument dictionary for the BULC-D algorithm.\
        var var_args_BULCD = \{\}\
        var_args_BULCD.defaultStudyArea = D.defaultStudyArea\
        var_args_BULCD.binCuts = D.binCuts\
        var_args_BULCD.targetLOFAsZScore = bulcD_input.targetLOFAsZScore\
        var_args_BULCD.modalityDictionary = D.modalityDictionary;\
\
        // Since BULC-D uses BULC, we also want to access the parameters for the BULC run.   \
                // Get the BULC-specific parameter dictionary.\
\
        var BULCargumentDictionaryPlus = getBULCParameterDictionary() // pulls the BULC-specific parameter set from another file.\
        // this would be where we would override any parameters using values from the interface.\
\
        // Add the BULC parameter dictionary to the BULC-D argument dictionary.\
        // Attach it to the set of things going into the BULC-D call.\
        var_args_BULCD.BULCargumentDictionaryPlus = BULCargumentDictionaryPlus\
\
    // ----------------------------------------------------------------------------\
        // RUN BULC-D ALGORITHM\
        // ----------------------------------------------------------------------------\
\
        // Call the BULC-D algorithm with the prepared arguments.\
        print("Arguments to BULC-D", var_args_BULCD)\
        fullBULCReturn = afn_BULCD(var_args_BULCD);\
        print('fullBULCReturn', fullBULCReturn);\
\
        // print(bulcD_input.targetCollection)\
\
        // ----------------------------------------------------------------------------\
        // EXPORT BASIC BULC-D INPUTS & RESULTS\
        // ----------------------------------------------------------------------------\
\
        // 0b. Adjusted R2\
        Export.image.toAsset(\{\
            image: ee.Image(bulcD_input.theExpectationR2).updateMask(theWaterMask),\
            description: 'Version-' + theVersion + '-0-Expectation-R2',\
            region: D.defaultStudyArea,\
            scale: 10,\
            maxPixels: maxExportPixels\
        \});\
\
        // 0c. Residual\
        Export.image.toAsset(\{\
            image: ee.Image(bulcD_input.theExpectationResiduals).updateMask(theWaterMask),\
            description: 'Version-' + theVersion + '-0-Expectation-Residuals',\
            region: D.defaultStudyArea,\
            scale: 10,\
            maxPixels: maxExportPixels\
        \});\
\
        // 4. Final BULC Probabilities\
        Export.image.toAsset(\{\
            image: ee.Image(fullBULCReturn.finalBULCprobs).updateMask(theWaterMask),\
            description: 'Version-' + theVersion + '-4-Final-BULC-Probabilities',\
            region: D.defaultStudyArea,\
            scale: 10,\
            maxPixels: maxExportPixels\
        \});\
\
        // 5a. Probability of Value Increase\
        Export.image.toAsset(\{\
            image: ee.Image(fullBULCReturn.finalBULCprobs).select(2).updateMask(theWaterMask),\
            description: 'Version-' + theVersion + '-5a-Probability-of-Value-Increase',\
            region: D.defaultStudyArea,\
            scale: 10,\
            maxPixels: maxExportPixels\
        \});\
\
        // 5b. Probability of Value Unchanged\
        Export.image.toAsset(\{\
            image: ee.Image(fullBULCReturn.finalBULCprobs).select(1).updateMask(theWaterMask),\
            description: 'Version-' + theVersion + '-5b-Probability-of-Value-Unchanged',\
            region: D.defaultStudyArea,\
            scale: 10,\
            maxPixels: maxExportPixels\
        \});\
\
        // 5c. Probability of Value Increase\
        Export.image.toAsset(\{\
            image: ee.Image(fullBULCReturn.finalBULCprobs).select(0).updateMask(theWaterMask),\
            description: 'Version-' + theVersion + '-5c-Probability-of-Value-Decrease',\
            region: D.defaultStudyArea,\
            scale: 10,\
            maxPixels: maxExportPixels\
        \});\
        // ----------------------------------------------------------------------------\
        // End of exporting BASIC BULC-D INPUTS & RESULTS\
        // ----------------------------------------------------------------------------\
        // ----------------------------------------------------------------------------\
        // CREATE LINKED MAPS\
        // ----------------------------------------------------------------------------\
\
        // Set up the linked maps for visualizing the analysis results.\
\
        mapGrid.clear();\
        mapGrid.add(getLinkedMaps(maps, bulcD_input, fullBULCReturn, D));\
\
        // ----------------------------------------------------------------------------\
        // ACCESS BULC ALGORITHM RESULTS FOR DISPLAY IN THIRD PANEL\
        // ----------------------------------------------------------------------------\
        \{\
            // COLLECTION (before bulc)\
            BULCargumentDictionary = BULCargumentDictionaryPlus.BULCargumentDictionary\
            COLLECTION = ee.ImageCollection(imageCollectionManipulationModule.afn_convertMultibandToCollectionSimpleV4(ee.Image(fullBULCReturn.allEventLayers)));\
            COLLECTION = helperFunctionsBULC.styleImg('ic', COLLECTION, 3, gena.crameri.oslo[10]);\
\
            // BULC_COLLECTION (after bulc)\
            BULC_COLLECTION = ee.ImageCollection(imageCollectionManipulationModule.afn_convertMultibandToCollectionSimpleV4(ee.Image(fullBULCReturn.allBULCLayers.byte())));\
            BULC_COLLECTION = helperFunctionsBULC.styleImg('ic', BULC_COLLECTION, 3, ['red', 'green', 'blue']);\
\
            // CONFIDENCE\
            CONFIDENCE = ee.ImageCollection(imageCollectionManipulationModule.afn_convertMultibandToCollectionSimpleV4(ee.Image(fullBULCReturn.allConfidenceLayers)));\
        \}\
\
        IMAGES = ee.ImageCollection(bulcD_input.targetCollection).map(function(image) \{\
            return image.select(D.bandNameToFit)\
        \})\
\
        // ----------------------------------------------------------------------------\
        // UPDATE THIRD PANEL (RESULTS)\
        // ----------------------------------------------------------------------------\
        thirdSubPanel.clear();\
        thirdPanel.clear();\
        thirdPanel.add(showModes());\
        thirdPanel.add(thirdSubPanel);\
    \}\
